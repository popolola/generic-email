{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "xlsx": ["./*"]
    },
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": false,
    "types": [],
    "noEmit": true,
    "strictFunctionTypes": true,
    "forceConsistentCasingInFileNames": true
  }
}